[
  {
    "contract": 1,
    "path": "jsm request list",
    "summary": "Requests you can see, by status, desk, type or text",
    "effect": "read",
    "confirm": false,
    "positionals": [],
    "flags": [
      {
        "name": "--status",
        "type": "enum",
        "values": [
          "open",
          "closed",
          "all"
        ],
        "required": false,
        "description": "open, closed or all"
      },
      {
        "name": "--desk",
        "type": "string",
        "required": false,
        "description": "Service desk ID, project key or exact name"
      },
      {
        "name": "--type",
        "type": "string",
        "required": false,
        "description": "Request type ID or exact name (needs --desk)"
      },
      {
        "name": "--query",
        "short": "-q",
        "type": "string",
        "required": false,
        "description": "Summary contains"
      },
      {
        "name": "--limit",
        "type": "integer",
        "required": false,
        "description": "How many records to return in total [default: 25, at most 1000]"
      },
      {
        "name": "--cursor",
        "type": "string",
        "required": false,
        "description": "Continue after a previous result: pass its `next`"
      },
      {
        "name": "--all",
        "type": "boolean",
        "required": false,
        "description": "Return up to 1000 records"
      }
    ],
    "record": {
      "name": "jsm.request",
      "description": "a customer request",
      "primary": "key",
      "fields": [
        {
          "name": "key",
          "type": "string",
          "description": "issue key",
          "default": true
        },
        {
          "name": "id",
          "type": "string",
          "description": "issue ID",
          "default": false
        },
        {
          "name": "title",
          "type": "string",
          "description": "summary",
          "default": true
        },
        {
          "name": "status",
          "type": "string",
          "description": "current status",
          "default": true
        },
        {
          "name": "type",
          "type": "string",
          "description": "request type ID",
          "default": true
        },
        {
          "name": "desk",
          "type": "string",
          "description": "service desk ID",
          "default": true
        },
        {
          "name": "reporter",
          "type": "user",
          "description": "who raised it ({id, name})",
          "default": true
        },
        {
          "name": "created",
          "type": "datetime",
          "description": "when it was raised",
          "default": true
        },
        {
          "name": "url",
          "type": "string",
          "description": "portal URL",
          "default": true
        },
        {
          "name": "description",
          "type": "string",
          "description": "description",
          "default": false
        },
        {
          "name": "fields",
          "type": "object",
          "description": "every request field, by label",
          "default": false
        }
      ]
    },
    "examples": [
      "atlx jsm request list --status open --desk HELP",
      "atlx jsm request list -q vpn --limit 10"
    ],
    "exitCodes": [
      0,
      1,
      2,
      4,
      5,
      7
    ]
  },
