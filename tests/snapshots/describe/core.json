  {
    "contract": 1,
    "path": "search",
    "summary": "Search Jira, Confluence and Bitbucket at once",
    "effect": "read",
    "confirm": false,
    "positionals": [
      {
        "name": "QUERY",
        "type": "string",
        "required": true
      }
    ],
    "flags": [
      {
        "name": "--limit",
        "type": "integer",
        "required": false,
        "default": "10",
        "description": "Max results per product"
      },
      {
        "name": "--only",
        "type": "enum",
        "values": [
          "jira",
          "confluence",
          "bitbucket"
        ],
        "required": false,
        "repeatable": true,
        "description": "Only search these products (comma-separated)"
      }
    ],
    "record": null,
    "examples": [
      "atlx search 'login timeout' --limit 5",
      "atlx search deploy --only jira,confluence"
    ],
    "exitCodes": [
      0,
      1,
      2,
      4,
      5,
      7
    ]
