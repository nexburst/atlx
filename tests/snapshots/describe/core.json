  {
    "contract": 1,
    "path": "auth status",
    "summary": "Who is signed in, on which site, with which token source; which products answer; whether read-only mode is on. Run this first",
    "effect": "read",
    "confirm": false,
    "positionals": [],
    "flags": [],
    "record": {
      "name": "auth.status",
      "description": "the signed-in account, its site and what it can reach",
      "primary": "profile",
      "fields": [
        {
          "name": "profile",
          "type": "string",
          "description": "selected profile",
          "default": true
        },
        {
          "name": "site",
          "type": "string",
          "description": "Atlassian site",
          "default": true
        },
        {
          "name": "email",
          "type": "string",
          "description": "account email",
          "default": true
        },
        {
          "name": "user",
          "type": "user",
          "description": "the Jira account ({id, name})",
          "default": true
        },
        {
          "name": "tokenSource",
          "type": "string",
          "description": "where the token comes from: env, config, token_cmd",
          "default": true
        },
        {
          "name": "readOnly",
          "type": "boolean",
          "description": "whether mutating requests are refused",
          "default": true
        },
        {
          "name": "products",
          "type": "object",
          "description": "per product: ok, not_configured, or the error code it answered with",
          "default": true
        },
        {
          "name": "bitbucketWorkspace",
          "type": "string",
          "description": "default Bitbucket workspace",
          "default": true
        },
        {
          "name": "defaults",
          "type": "object",
          "description": "repo-local defaults (.atlx.toml and the git remote)",
          "default": false
        }
      ]
    },
    "examples": [
      "atlx auth status",
      "atlx auth status -p work --fields user,products"
    ],
    "exitCodes": [
      0,
      1,
      2,
      4,
      5,
      7
    ]
  },
  {
