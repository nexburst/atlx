  {
    "contract": 1,
    "path": "api",
    "summary": "Call any REST endpoint directly",
    "description": "Call any REST endpoint directly\n\nPaths are relative to https://SITE (jira), https://SITE/wiki (confluence) or https://api.bitbucket.org/2.0 (bitbucket, where `{workspace}` is replaced with your default workspace). The response goes in `data` untouched. Read-only mode and --dry-run apply to it like to every other command.",
    "effect": "by-method",
    "effectByMethod": {
      "GET": "read",
      "HEAD": "read",
      "OPTIONS": "read",
      "POST": "write",
      "PUT": "write",
      "PATCH": "write",
      "DELETE": "destructive"
    },
    "confirm": false,
    "positionals": [
      {
        "name": "PRODUCT",
        "type": "enum",
        "values": [
          "jira",
          "confluence",
          "bitbucket"
        ],
        "required": true
      },
      {
        "name": "PATH",
        "type": "string",
        "required": true
      }
    ],
    "flags": [
      {
        "name": "--method",
        "short": "-X",
        "type": "string",
        "required": false,
        "default": "GET"
      },
      {
        "name": "--data",
        "short": "-d",
        "type": "string",
        "required": false,
        "description": "JSON body; `-` reads stdin, `@file` reads a file"
      },
      {
        "name": "--query",
        "short": "-q",
        "type": "string",
        "required": false,
        "repeatable": true,
        "description": "Query parameter, repeatable"
      },
      {
        "name": "--yes",
        "short": "-y",
        "type": "boolean",
        "required": false,
        "description": "Confirm a DELETE (other methods don't need it)"
      }
    ],
    "record": null,
    "examples": [
      "atlx api jira /rest/api/3/myself",
      "atlx api confluence /api/v2/pages -q limit=5",
      "atlx api jira /rest/api/3/issue -X POST -d @issue.json --dry-run",
      "atlx api jira /rest/api/3/issue/PROJ-1 -X DELETE --yes"
    ],
    "exitCodes": [
      0,
      1,
      2,
      4,
      5,
      6,
      7,
      8
    ]
  },
