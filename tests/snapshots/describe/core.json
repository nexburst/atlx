    "record": {
      "name": "auth.profile",
      "description": "a saved login profile (never the token)",
      "primary": "name",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "description": "profile name",
          "default": true
        },
        {
          "name": "default",
          "type": "boolean",
          "description": "used when none is selected",
          "default": true
        },
        {
          "name": "active",
          "type": "boolean",
          "description": "selected for this run",
          "default": true
        },
        {
          "name": "site",
          "type": "string",
          "description": "Atlassian site",
          "default": true
        },
        {
          "name": "email",
          "type": "string",
          "description": "account email",
          "default": true
        },
        {
          "name": "workspace",
          "type": "string",
          "description": "default Bitbucket workspace",
          "default": true
        },
        {
          "name": "tokenSource",
          "type": "string",
          "description": "config, token_cmd or none",
          "default": true
        },
        {
          "name": "bitbucketTokenSource",
          "type": "string",
          "description": "where the Bitbucket token comes from",
          "default": false
        },
        {
          "name": "readOnly",
          "type": "boolean",
          "description": "read-only profile",
          "default": true
