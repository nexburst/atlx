[
  {
    "contract": 1,
    "path": "auth login",
    "summary": "Save credentials (site, email, API token) into a profile",
    "effect": "write",
    "confirm": false,
    "positionals": [],
    "flags": [
      {
        "name": "--token",
        "type": "string",
        "required": false,
        "description": "API token (https://id.atlassian.com/manage-profile/security/api-tokens); `-` reads stdin"
      },
      {
        "name": "--token-cmd",
        "type": "string",
        "required": false,
        "description": "Save a shell command that prints the API token, instead of the token itself"
      },
      {
        "name": "--no-verify",
        "type": "boolean",
        "required": false,
        "description": "Skip credential verification"
      },
      {
        "name": "--force",
        "short": "-f",
        "type": "boolean",
        "required": false,
        "description": "Re-prompt for everything, ignoring saved values"
      },
      {
        "name": "--new-profile",
        "type": "string",
        "required": false,
        "description": "Save into a new profile; without a name, one is derived from the site"
      }
    ],
    "record": null,
    "examples": [
      "atlx auth login --new-profile work -s acme -u me@acme.com --token-cmd 'pass show atlassian'",
      "atlx auth login -p work --force"
    ],
    "exitCodes": [
      0,
      1,
      2,
      4,
      5,
      6,
      7,
      8
    ]
  },
